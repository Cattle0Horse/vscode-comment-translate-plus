# pnpm serve:local / pnpm test:local 自动读取仓库根目录 .env。
COMMENT_TRANSLATE_TEST_API_URL=http://127.0.0.1:9999/v1/chat/completions
COMMENT_TRANSLATE_TEST_API_KEY=
# 可选；省略时查询上述服务的 models 接口。
# COMMENT_TRANSLATE_TEST_MODEL=your-model-id
# 可选；省略时从 API 地址派生测试 profile ID。
# COMMENT_TRANSLATE_TEST_PROFILE_ID=local
