        "commentTranslatePlus.activeProfile": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "当前使用的翻译配置，填写 profiles 中某一项的 id。留空时使用列表第一项；也可通过状态栏的“选择翻译配置”切换。"
        },
        "commentTranslatePlus.displayMode": {
          "type": "string",
          "enum": [
            "contrast",
            "inplace"
          ],
          "default": "contrast",
          "scope": "window",
          "description": "阅读模式下译文的显示方式：contrast 在完整原文下方显示译文，inplace 在原文位置显示译文，编辑对应内容时恢复原文。两种方式均不修改源文件。",
          "enumDescriptions": [
            "对照：在完整原文下方显示译文",
            "占位：在原文位置显示译文，编辑时恢复原文"
          ]
        },
        "commentTranslatePlus.browse.comments": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "开启当前文档的阅读模式后，翻译代码注释。此选项只控制阅读模式中的内容，悬停翻译由 hover.comments 单独控制。"
        },
        "commentTranslatePlus.browse.strings": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "开启当前文档的阅读模式后，翻译代码中引号内的字符串，保留引号、转义和模板中的变量。悬停字符串是否翻译由 hover.strings 单独控制。"
        },
        "commentTranslatePlus.hover.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "鼠标停留在内容上时显示译文，无需先开启阅读模式。关闭后停止悬停翻译；下方各类悬停选项仅在此开关开启时生效。"
        },
        "commentTranslatePlus.hover.comments": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "鼠标停留在代码注释上时显示译文。需要开启 hover.enabled。"
        },
        "commentTranslatePlus.hover.strings": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "鼠标停留在代码字符串上时显示译文，保留转义和模板中的变量。需要开启 hover.enabled。"
        },
        "commentTranslatePlus.hover.selection": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "选中文本后，将鼠标停留在选区内可翻译所选内容。可点击译文浮层中的替换按钮将译文写回原文。需要开启 hover.enabled。"
        },
        "commentTranslatePlus.hover.documentation": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "翻译语言扩展提供的悬停说明和当前位置的错误、警告信息，例如函数说明或类型错误；保留原有提示和操作。需要开启 hover.enabled。"
        },
        "commentTranslatePlus.hover.nearCursor": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "让译文浮层靠近鼠标停留的位置；关闭后按被翻译内容的范围定位。需要开启 hover.enabled。"
        },
        "commentTranslatePlus.auto.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "打开受支持的工作区文件时，自动开启阅读模式并翻译可见内容。翻译范围由 auto.include 和 auto.exclude 决定；默认关闭，需要手动开启阅读模式。"
        },
        "commentTranslatePlus.auto.include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "**/*"
          ],
          "scope": "resource",
          "description": "选择哪些工作区文件自动开启阅读模式，需要开启 auto.enabled。使用相对工作区根目录的通配路径，并以 / 分隔，例如 **/*.md 匹配所有 Markdown 文件、docs/** 匹配 docs 目录内文件。任意一条匹配即可；默认 **/* 包含全部文件，空列表不包含任何文件，auto.exclude 优先。"
        },
        "commentTranslatePlus.auto.exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "**/.git/**",
            "**/.venv/**",
            "**/node_modules/**",
            "**/.ruff_cache/**",
            "**/.pytest_cache/**",
            "**/__pycache__/**",
            "**/.mypy_cache/**",
            "**/.tox/**",
            "**/.nox/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/coverage/**"
          ],
          "scope": "resource",
          "description": "选择哪些工作区文件不自动开启阅读模式，优先于 auto.include；后台翻译所有文件也遵循此列表。默认排除 .git、.venv、node_modules、Python 缓存和常见构建输出。使用相对工作区根目录的通配路径，以 / 分隔；手动翻译仍可使用。"
        },
        "commentTranslatePlus.preserveTermsWriteFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "执行“添加保留词”时写入的 JSON/JSONC 文件，例如 .vscode/preserve-terms.jsonc。留空时首次使用命令会让你选择并保存路径；文件或父目录不存在时自动创建。支持工作区相对路径、绝对路径、网络共享路径、~/ 和可写文件系统 URI。要让此文件参与翻译，还需将它加入 preserveTerms。"
        },
        "commentTranslatePlus.preserveTerms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "scope": "resource",
          "description": "阅读模式和翻译预览使用的保留词文件列表，填写 JSON/JSONC 文件路径或 HTTPS 地址，多个文件会合并。未设置时使用内置词表，自定义列表替换内置词表，空列表禁用词表。仅整段待译内容匹配时跳过翻译，句子中出现词条不会跳过整句；悬停和“翻译并替换”不使用词表。支持工作区相对路径、绝对路径、网络共享路径、~/ 和文件系统 URI；HTTP 仅支持本机回环地址。"
        },
        "commentTranslatePlus.minimumMarkerCharacters": {
          "type": "integer",
          "default": 32,
          "minimum": 1,
          "maximum": 200000,
          "scope": "window",
          "description": "不可翻译的长数据至少达到多少个字符时，才考虑用短标记代替发送，以减少请求长度；译文显示时会还原数据。仅在能明显缩短请求时使用，普通名称和自然语言不会仅因长度被替换。通常保持默认。字符按 UTF-16 计数。"
        },
        "commentTranslatePlus.maxItemsPerRequest": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 1000,
          "scope": "window",
          "description": "一次请求最多包含多少个独立翻译片段，例如段落、标题或表格单元格，而非文件行数。实际数量还受请求长度和内容分组限制；调低可减小单次请求，但可能增加请求次数。"
        },
        "commentTranslatePlus.maxRequestCharacters": {
          "type": "integer",
          "default": 12000,
          "minimum": 256,
          "maximum": 200000,
          "scope": "window",
          "description": "一次请求允许的最大字符数。OpenAI 兼容服务计算全部消息文本，包括提示词、正文、参考和重试说明；Google/Bing 计算待译文本。按 UTF-16 字符计数，不是 token 数。超出上限的单个片段会报错，不会截断原文。"
        },
        "commentTranslatePlus.maxContextCharacters": {
          "type": "integer",
          "default": 2000,
          "minimum": 0,
          "maximum": 200000,
          "scope": "window",
          "description": "一次请求最多附带多少个字符的上下文参考，帮助模型理解正文；0 表示不附带参考。按 UTF-16 字符计数，并受总请求长度限制。Google/Bing 不发送参考；通常保持默认。"
        },
        "commentTranslatePlus.maxUnitContextCharacters": {
          "type": "integer",
          "default": 1000,
          "minimum": 0,
          "maximum": 200000,
          "scope": "window",
          "description": "为每个独立翻译片段最多选取多少个字符的上下文参考；0 表示不附带参考。仅选择放得下的完整参考块，仍受整次请求的参考和总长度限制。按 UTF-16 字符计数；Google/Bing 不发送参考。"
        },
        "commentTranslatePlus.adaptiveBatching": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "仅用于 OpenAI 兼容服务：根据翻译成功或失败自动调整每次发送的内容量。关闭后使用初始项数和字符目标；失败内容仍会按重试规则缩小批次重试。通常建议开启。"
        },
        "commentTranslatePlus.batchBySemanticScope": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "将同一章节、列表、表格或 YAML 层级内的内容放在同一批翻译，减少不相关内容混在一次请求中。关闭后允许跨这些范围合并，仍受项数和字符上限限制。"
        },
        "commentTranslatePlus.initialItemsPerRequest": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 1000,
          "scope": "window",
          "description": "仅用于 OpenAI 兼容服务：开始时每次请求计划翻译多少个片段，实际不超过 maxItemsPerRequest。开启 adaptiveBatching 后会自动调整；关闭后一直以此值作为目标。"
        },
        "commentTranslatePlus.initialRequestCharacters": {
          "type": "integer",
          "default": 6000,
          "minimum": 256,
          "maximum": 200000,
          "scope": "window",
          "description": "仅用于 OpenAI 兼容服务：开始时每次请求计划使用的消息字符数，包括提示词、正文和参考。开启 adaptiveBatching 后会自动调整。为保留完整片段可超过此目标，但不能超过 maxRequestCharacters；按 UTF-16 字符计数。"
        },
        "commentTranslatePlus.batchGrowthSuccesses": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 1000,
          "scope": "window",
          "description": "开启 adaptiveBatching 后，达到当前项数或字符目标的请求累计成功多少次，才增加每次发送的内容量。失败会重新计数，内容不足的小批次成功不计入。仅用于 OpenAI 兼容服务。"
        },
        "commentTranslatePlus.batchGrowthItems": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 1000,
          "scope": "window",
          "description": "开启 adaptiveBatching 后，每轮增加多少个翻译片段。例如设为 1，每轮将项数目标增加 1，最多达到 maxItemsPerRequest。仅用于 OpenAI 兼容服务。"
        },
        "commentTranslatePlus.batchGrowthFactor": {
          "type": "number",
          "default": 1.25,
          "minimum": 1,
          "maximum": 4,
          "scope": "window",
          "description": "开启 adaptiveBatching 后，每轮将消息字符目标乘以多少。例如 1.25 表示增加 25%，1 表示不增加；最多达到 maxRequestCharacters。仅用于 OpenAI 兼容服务。"
        },
        "commentTranslatePlus.batchShrinkFactor": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.1,
          "maximum": 1,
          "scope": "window",
          "description": "翻译结果不完整等可重试失败发生时，将批次的项数和字符目标缩小到原来的多少。例如 0.5 表示减半，1 表示不按比例缩小。也用于安排失败内容的重试批次，最后一次逐项重试；关闭 adaptiveBatching 后仍适用于重试。仅用于 OpenAI 兼容服务。"
        },
        "commentTranslatePlus.maxTranslationAttempts": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "scope": "window",
          "description": "仅用于 OpenAI 兼容服务：一次翻译任务中，每个片段最多尝试多少次，包含首次请求；1 表示不自动重试。用于可恢复的请求失败、结果缺失或格式错误，成功片段不重复请求；鉴权等不可恢复错误直接报告。"
        },
        "commentTranslatePlus.preserveTermsRefreshSeconds": {
          "type": "integer",
          "default": 900,
          "minimum": 0,
          "maximum": 86400,
          "scope": "window",
          "description": "每隔多少秒重新读取本地和网络保留词文件，默认 900 秒（15 分钟）。0 表示只手动刷新；修改词表文件后不会立即自动读取，可执行“刷新保留词”立即更新。更新后的词表用于后续任务，已有译文不会因此重新翻译。"
        },
        "commentTranslatePlus.actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "toggleDocumentBrowseMode",
              "translateAll",
              "translateWorkspace",
              "retranslateBlock",
              "cancel",
              "retranslate",
              "retry",
              "translateAndReplace",
              "addPreserveTerm",
              "setLanguages",
              "selectProfile",
              "toggleMode",
              "toggleHover",
              "toggleAuto",
              "addCurrentFileToAutoExclude",
              "addCurrentFileToAutoInclude",
              "preview",
              "showCacheUsage",
              "clearPersistentCache",
              "settings",
              "showErrors"
            ],
            "enumDescriptions": [
              "切换当前文档注释浏览模式",
              "翻译全文",
              "后台翻译所有文件",
              "重新翻译当前块",
              "取消进行中的翻译；已取消时继续翻译",
              "重新翻译当前文件",
              "重试失败批次",
              "翻译并替换",
              "添加保留词",
              "源语言与目标语言",
              "选择翻译配置",
              "切换对照 / 占位模式",
              "开启 / 关闭悬停翻译",
              "开启 / 关闭工作区自动注释浏览",
              "添加当前文件到自动翻译排除规则",
              "添加当前文件到自动翻译包含规则",
              "打开 Markdown 翻译预览",
              "查看缓存使用情况",
              "清空持久化缓存",
              "扩展设置",
              "查看日志与错误"
            ]
          },
          "uniqueItems": true,
          "default": [
            "toggleDocumentBrowseMode",
            "translateAll",
            "translateWorkspace",
            "retranslateBlock",
            "cancel",
            "retranslate",
            "retry",
            "translateAndReplace",
            "addPreserveTerm",
            "setLanguages",
            "selectProfile",
            "toggleMode",
            "toggleHover",
            "toggleAuto",
            "addCurrentFileToAutoExclude",
            "addCurrentFileToAutoInclude",
            "preview",
            "showCacheUsage",
            "clearPersistentCache",
            "settings",
            "showErrors"
          ],
          "scope": "resource",
          "markdownDescription": "自定义状态栏和“注释浏览操作”菜单：按列表顺序显示，删除条目即可隐藏，空列表隐藏全部。填写不带 `commentTranslatePlus.` 前缀的操作 ID，例如 `translateAll`。`cancel` 在取消后显示为“继续翻译”。部分操作仅在适用的文档或翻译状态下显示；修改后下次打开菜单生效。此设置不影响命令面板或快捷键。"
        }
      }
    },
    "submenus": [
      {
        "id": "commentTranslatePlus.browseMenu",
        "label": "注释翻译+"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "commentTranslatePlus.toggleDocumentBrowseMode",
          "when": "commentTranslatePlus.supported && !commentTranslatePlus.browse",
          "group": "navigation@20"
        },
        {
          "command": "commentTranslatePlus.toggleDocumentBrowseMode.active",
          "when": "commentTranslatePlus.supported && commentTranslatePlus.browse",
          "group": "navigation@20"
        },
        {
          "command": "commentTranslatePlus.preview",
          "when": "commentTranslatePlus.markdown",
          "group": "navigation@22"
        },
        {
          "command": "commentTranslatePlus.retranslatePreview",
          "when": "activeCustomEditorId == vscode.markdown.preview.editor && resourceScheme == comment-translate-plus-preview",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "submenu": "commentTranslatePlus.browseMenu",
          "when": "commentTranslatePlus.supported",
          "group": "navigation@20"
        }
      ],
      "commentTranslatePlus.browseMenu": [
        {
          "command": "commentTranslatePlus.translateAll",
          "group": "browse@1"
        },
        {
          "command": "commentTranslatePlus.translateWorkspace",
          "group": "browse@1.1"
        },
        {
          "command": "commentTranslatePlus.toggleDocumentBrowseMode",
          "group": "browse@0"
        },
        {
          "command": "commentTranslatePlus.cancel",
          "group": "browse@2",
          "when": "commentTranslatePlus.browse"
        },
        {
          "command": "commentTranslatePlus.retranslate",
          "group": "browse@3",
          "when": "commentTranslatePlus.browse"
        },
        {
          "command": "commentTranslatePlus.retranslateBlock",
          "group": "browse@3.1"
        },
        {
          "command": "commentTranslatePlus.retry",
          "group": "browse@4",
          "when": "commentTranslatePlus.browse"
        },
        {
          "command": "commentTranslatePlus.showErrors",
          "group": "browse@5"
        },
        {
          "command": "commentTranslatePlus.setLanguages",
          "group": "browse@6"
        },
        {
          "command": "commentTranslatePlus.settings",
          "group": "browse@7"
        },
        {
          "command": "commentTranslatePlus.selectProfile",
          "group": "browse@8"
        },
        {
          "command": "commentTranslatePlus.toggleMode",
          "group": "browse@9"
        },
        {
          "command": "commentTranslatePlus.toggleHover",
          "group": "browse@10"
        },
        {
          "command": "commentTranslatePlus.toggleAuto",
          "group": "browse@11"
        },
        {
          "command": "commentTranslatePlus.preview",
          "group": "browse@12",
          "when": "commentTranslatePlus.markdown"
        },
        {
          "command": "commentTranslatePlus.translateAndReplace",
          "group": "browse@13"
        },
        {
          "command": "commentTranslatePlus.addCurrentFileToAutoExclude",
          "group": "browse@14"
        },
        {
          "command": "commentTranslatePlus.addCurrentFileToAutoInclude",
          "group": "browse@15"
        }
      ],
      "commandPalette": [
        {
          "command": "commentTranslatePlus.toggleDocumentBrowseMode.active",
          "when": "false"
        },
        {
          "command": "commentTranslatePlus.retranslatePreview",
          "when": "activeCustomEditorId == vscode.markdown.preview.editor && resourceScheme == comment-translate-plus-preview"
        }
      ]
    }
  }
}
