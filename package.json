{
  "name": "vscode-comment-translate-plus",
  "displayName": "注释翻译+",
  "description": "注释、Markdown 与指令文件沉浸式翻译，独立悬停、Markdown 翻译预览和可切换翻译服务",
  "icon": "resources/icon.png",
  "version": "0.11.0",
  "publisher": "cattle-horse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cattle0Horse/vscode-comment-translate-plus.git"
  },
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0",
    "vscode": "^1.140.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:comment-translate-plus-preview"
  ],
  "files": [
    "dist/extension.cjs",
    "dist/ThirdPartyNotices.txt",
    "dist/onig.wasm",
    "dist/loading.svg",
    "resources/icon.png",
    "resources/preview.css",
    "resources/preserve-terms.json",
    "resources/preserve-terms.full.json",
    "preserve-terms/licenses/*.txt"
  ],
  "scripts": {
    "check": "node tools/check.mjs && node tools/architecture.mjs && node --run typecheck && node --run format:check",
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "test": "node tools/build.mjs --tests && node --test tests/*.test.mjs artifacts/tests/*.test.cjs",
    "test:extension": "node tools/build.mjs --tests && node tools/test-desktop.mjs",
    "test:package": "node tools/build.mjs --tests && node --run package && node tools/test-desktop.mjs --package",
    "package": "node tools/package.mjs",
    "release": "bumpp --no-push --commit \"chore(release): 发布 {tag}\" --tag \"v{version}\"",
    "vscode:install": "code --install-extension artifacts/comment-translate-plus.vsix --force",
    "vscode:build:install": "node --run package && node --run vscode:install",
    "vscode:prepublish": "node --run check && node tools/build.mjs --production",
    "verify": "node tools/verify.mjs",
    "bench": "node tools/bench.mjs",
    "test:local": "node tools/build.mjs --tests && node tools/test-desktop.mjs --local",
    "serve:local": "node tools/build.mjs --tests && node tools/test-desktop.mjs --local --interactive",
    "test:ui": "node tools/build.mjs --tests && node tools/test-desktop.mjs --ui",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt . && oxlint --fix .",
    "format:check": "oxfmt --check . && node --run lint",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "serve:desktop": "node tools/build.mjs --tests && node tools/test-desktop.mjs --interactive"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.0.0",
    "bumpp": "12.3.0",
    "changelogithub": "15.0.5",
    "esbuild": "0.28.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "playwright": "1.64.1",
    "typescript": "~6.0.3",
    "yauzl": "^3.4.0"
  },
  "dependencies": {
    "@lezer/markdown": "1.8.1",
    "jsonc-parser": "3.3.1",
    "tinyld": "^1.3.4",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "yaml": "2.9.1"
  },
  "contributes": {
    "markdown.previewStyles": [
      "./resources/preview.css"
    ],
    "commands": [
      {
        "command": "commentTranslatePlus.toggleDocumentBrowseMode",
        "title": "切换当前文档注释浏览模式",
        "category": "Comment Translate Plus",
        "icon": "$(eye-closed)"
      },
      {
        "command": "commentTranslatePlus.toggleDocumentBrowseMode.active",
        "title": "切换当前文档注释浏览模式",
        "category": "Comment Translate Plus",
        "icon": "$(eye)"
      },
      {
        "command": "commentTranslatePlus.cancel",
        "title": "取消进行中的翻译",
        "category": "Comment Translate Plus",
        "icon": "$(debug-stop)"
      },
      {
        "command": "commentTranslatePlus.translateAll",
        "title": "翻译全文",
        "category": "Comment Translate Plus",
        "enablement": "commentTranslatePlus.supported"
      },
      {
        "command": "commentTranslatePlus.translateWorkspace",
        "title": "后台翻译所有文件",
        "category": "Comment Translate Plus",
        "icon": "$(cloud-download)"
      },
      {
        "command": "commentTranslatePlus.retranslate",
        "title": "重新翻译当前文件",
        "category": "Comment Translate Plus",
        "icon": "$(refresh)"
      },
      {
        "command": "commentTranslatePlus.retranslateBlock",
        "title": "重新翻译当前块",
        "category": "Comment Translate Plus",
        "icon": "$(refresh)"
      },
      {
        "command": "commentTranslatePlus.retry",
        "title": "重试当前文件失败批次",
        "category": "Comment Translate Plus",
        "icon": "$(debug-restart)"
      },
      {
        "command": "commentTranslatePlus.showErrors",
        "title": "查看翻译状态与错误",
        "category": "Comment Translate Plus",
        "icon": "$(output)"
      },
      {
        "command": "commentTranslatePlus.showCacheUsage",
        "title": "查看缓存使用情况",
        "category": "Comment Translate Plus"
      },
      {
        "command": "commentTranslatePlus.clearPersistentCache",
        "title": "清空持久化缓存",
        "category": "Comment Translate Plus"
      },
      {
        "command": "commentTranslatePlus.actions",
        "title": "注释浏览操作",
        "category": "Comment Translate Plus",
        "icon": "$(ellipsis)"
      },
      {
        "command": "commentTranslatePlus.setLanguages",
        "title": "设置源语言或目标语言",
        "category": "Comment Translate Plus",
        "icon": "$(translate)"
      },
      {
        "command": "commentTranslatePlus.settings",
        "title": "打开扩展设置",
        "category": "Comment Translate Plus",
        "icon": "$(settings-gear)"
      },
      {
        "command": "commentTranslatePlus.selectProfile",
        "title": "选择翻译配置",
        "category": "Comment Translate Plus",
        "icon": "$(server)"
      },
      {
        "command": "commentTranslatePlus.toggleMode",
        "title": "切换对照或占位模式",
        "category": "Comment Translate Plus",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "commentTranslatePlus.toggleHover",
        "title": "开启或关闭悬停翻译",
        "category": "Comment Translate Plus",
        "icon": "$(comment)"
      },
      {
        "command": "commentTranslatePlus.toggleAuto",
        "title": "开启或关闭工作区自动注释浏览",
        "category": "Comment Translate Plus",
        "icon": "$(play)"
      },
      {
        "command": "commentTranslatePlus.preview",
        "title": "打开 Markdown 翻译预览",
        "category": "Comment Translate Plus",
        "icon": "$(open-preview)"
      },
      {
        "command": "commentTranslatePlus.translateAndReplace",
        "title": "翻译并替换",
        "category": "Comment Translate Plus"
      },
      {
        "command": "commentTranslatePlus.retranslatePreview",
        "title": "重新翻译",
        "category": "Comment Translate Plus",
        "icon": "$(refresh)"
      },
      {
        "command": "commentTranslatePlus.addPreserveTerm",
        "title": "添加保留词",
        "category": "Comment Translate Plus"
      },
      {
        "command": "commentTranslatePlus.refreshPreserveTerms",
        "title": "刷新保留词",
        "category": "Comment Translate Plus"
      },
      {
        "command": "commentTranslatePlus.addCurrentFileToAutoExclude",
        "title": "添加当前文件到自动翻译排除规则",
        "category": "Comment Translate Plus"
      },
      {
        "command": "commentTranslatePlus.addCurrentFileToAutoInclude",
        "title": "添加当前文件到自动翻译包含规则",
        "category": "Comment Translate Plus"
      }
    ],
