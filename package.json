        "commentTranslatePlus.logDetails": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "在同一通道查看实际请求消息和模型响应，不追加原文与译文对照；相同 system 只定义一次并编号引用，正常响应仅显示正文，异常保留原始响应。默认关闭，切换不重译，密钥始终脱敏"
        },
        "commentTranslatePlus.logLevel": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "default": "info",
          "scope": "window",
          "description": "输出日志的最低级别。info 为任务开始/结束及失败重试，成功请求仅在 logDetails 开启时显示；warning 保留校验失败/重试及错误，error 仅最终错误。完整请求消息和模型响应由 logDetails 控制。切换不重译，配置密钥和认证头不打印"
        },
        "commentTranslatePlus.skipSameLanguage": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "离线检测文本语种，判断与目标基础语种一致时保留原文，不发送请求。短文本、混合或不确定内容仍翻译；zh-CN/zh-TW 同属中文，不用于繁简转换"
        },
        "commentTranslatePlus.persistentCache": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "持久化保存已验证的单元译文，重载后按需复用。译文明文保存在扩展存储目录，不参与设置同步；关闭时删除持久化副本，保留当前内存缓存"
        },
        "commentTranslatePlus.persistentCacheMaxEntries": {
          "type": "integer",
          "default": 10000,
          "minimum": 1,
          "maximum": 1000000,
          "scope": "window",
          "description": "持久化缓存最大单元数；超出条数或容量限制时，按最近使用顺序批量淘汰至两项上限的 80%"
        },
        "commentTranslatePlus.persistentCacheMaxSizeMB": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 1024,
          "scope": "window",
          "description": "持久化缓存中摘要与译文的有效载荷上限，单位 MiB（1024 × 1024 字节）；SQLite 索引、空闲页及 WAL 额外占用空间"
        },
        "commentTranslatePlus.editDebounceMs": {
          "type": "integer",
          "default": 1000,
          "minimum": 0,
          "maximum": 60000,
          "scope": "window",
          "description": "阅读或预览开启时，最后一次文本编辑后等待多久再自动翻译，单位毫秒；0 关闭等待。修改从下一次编辑生效，等待期间悬停不提前发送请求"
        },
        "commentTranslatePlus.maxRequestsPerSecond": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 100,
          "scope": "window",
          "description": "所有文件共享的每秒滑动窗口最大请求数"
        },
        "commentTranslatePlus.maxConcurrentRequests": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 20,
          "scope": "window",
          "description": "所有文件共享的最大同时进行请求数"
        },
