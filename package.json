        "commentTranslatePlus.activeProfile": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "当前翻译配置 ID；空值选择 profiles 的第一项"
        },
        "commentTranslatePlus.displayMode": {
          "type": "string",
          "enum": [
            "contrast",
            "inplace"
          ],
          "default": "contrast",
          "scope": "window",
          "description": "contrast 在原文旁对照显示，inplace 视觉占位；编辑对应内容时恢复原文"
        },
        "commentTranslatePlus.browse.comments": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "注释浏览包含代码注释；使用当前语言的 TextMate 语法识别，不修改源文件"
        },
        "commentTranslatePlus.browse.strings": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "注释浏览包含字符串字面量；保留引号、转义和模板插值。与字符串悬停开关独立"
        },
        "commentTranslatePlus.hover.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "启用独立悬停翻译，与注释浏览模式开关分别控制"
        },
        "commentTranslatePlus.hover.comments": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "悬停翻译代码注释"
        },
        "commentTranslatePlus.hover.strings": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "悬停翻译字符串"
        },
        "commentTranslatePlus.hover.selection": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "悬停非空选区时翻译该范围；可通过 hover 的替换按钮写回，不增加独立翻译或复制命令"
        },
        "commentTranslatePlus.hover.documentation": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "翻译其他语言服务的 hover 文档和错误说明，保留原有内容及操作"
        },
        "commentTranslatePlus.hover.nearCursor": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "在当前鼠标位置附近显示悬停浮层"
        },
        "commentTranslatePlus.auto.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "自动开启工作区内受支持文件的注释浏览模式，遵循 auto.include 和 auto.exclude；默认关闭"
        },
        "commentTranslatePlus.auto.include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "**/*"
          ],
          "scope": "resource",
          "description": "自动翻译包含规则，相对文件所属工作区根目录使用 / 分隔的 VS Code glob，例如 **/*.md、docs/**。任意一条命中即可，auto.exclude 优先排除；默认匹配所有文件，空数组不自动开启任何文件，不影响手动翻译。"
        },
        "commentTranslatePlus.auto.exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "scope": "resource",
          "description": "自动翻译排除规则，相对文件所属工作区根目录使用 / 分隔的 VS Code glob，例如 **/node_modules/**、**/*.min.js。空数组不排除；只限制自动开启，不影响手动翻译。"
        },
        "commentTranslatePlus.preserveTermsWriteFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "添加保留词命令的固定写入文件：支持工作区相对路径、绝对路径、UNC、~/（桌面宿主）和文件系统 URI，需为可写 JSON/JSONC 文件；不存在时自动创建文件及父目录。留空时首次选择并保存路径；与 preserveTerms 来源列表独立，不自动加入翻译词表。"
        },
        "commentTranslatePlus.preserveTerms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "scope": "resource",
          "description": "保留词 JSON/JSONC 文件来源列表：支持工作区相对路径、Windows/Linux 绝对路径、UNC、~/（桌面宿主）、file URI 和 HTTPS；多个文件合并。未设置使用内置词表，自定义列表替换默认，空数组清空；只匹配完整待译正文，不影响混合正文。HTTP 仅允许回环地址。"
        },
        "commentTranslatePlus.minimumMarkerCharacters": {
          "type": "integer",
          "default": 32,
          "minimum": 1,
          "maximum": 200000,
          "scope": "window",
          "description": "使用 CTP 压缩不可翻译长数据的最小 UTF-16 字符数；实际标记还须不超过原片段长度的四分之一。普通名称和自然语言不因长度生成 CTP"
        },
        "commentTranslatePlus.maxItemsPerRequest": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 1000,
          "scope": "window",
          "description": "单次翻译请求的语义单元数硬上限；正文保持完整，实际组批还受语义范围和字符预算限制"
        },
        "commentTranslatePlus.maxRequestCharacters": {
          "type": "integer",
          "default": 12000,
          "minimum": 256,
          "maximum": 200000,
          "scope": "window",
          "description": "OpenAI 最终 system 与 user 文本的 UTF-16 字符硬上限，包含提示词、正文、参考及分隔，不是 token 或 HTTP/JSON 字节。传统服务按待译文本计量"
        },
        "commentTranslatePlus.maxContextCharacters": {
          "type": "integer",
          "default": 2000,
          "minimum": 0,
          "maximum": 200000,
          "scope": "window",
          "description": "每次请求实际展开的参考内容 UTF-16 字符硬上限；0 禁用参考。单元参考另受 maxUnitContextCharacters 限制；无内部保护标记时省略相同原文，有标记时可保留完整原文以补足语境"
        },
        "commentTranslatePlus.maxUnitContextCharacters": {
          "type": "integer",
          "default": 1000,
          "minimum": 0,
          "maximum": 200000,
          "scope": "window",
          "description": "单个语义单元的参考内容 UTF-16 字符上限；0 禁用参考。按优先级选取完整块，不截断，同时服从请求参考与总字符硬上限"
        },
        "commentTranslatePlus.adaptiveBatching": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "OpenAI 根据满容量成功与可恢复失败调整组批软目标；关闭后保持初始软目标。失败项仍按尝试次数和缩批系数恢复，最后一次逐项尝试"
        },
        "commentTranslatePlus.batchBySemanticScope": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "语义范围变化时结束当前批，如具体章节、引用容器、父列表、表格或 YAML 父映射变化；关闭后仍服从项数、字符和参考预算"
        },
        "commentTranslatePlus.initialItemsPerRequest": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 1000,
          "scope": "window",
          "description": "OpenAI 初始每请求项数软目标，实际不超过 maxItemsPerRequest；关闭自适应时保持此目标"
        },
        "commentTranslatePlus.initialRequestCharacters": {
          "type": "integer",
          "default": 6000,
          "minimum": 256,
          "maximum": 200000,
          "scope": "window",
          "description": "OpenAI 初始最终 system+user 文本 UTF-16 字符软目标，受 maxRequestCharacters 约束；完整单项可超过软目标但不能超过硬上限"
        },
        "commentTranslatePlus.batchGrowthSuccesses": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 1000,
          "scope": "window",
          "description": "OpenAI 满容量成功累计达到此次数后增长软目标；可恢复失败清零计数，未满容量的成功不计数"
        },
        "commentTranslatePlus.batchGrowthItems": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 1000,
          "scope": "window",
          "description": "OpenAI 每次成功增长时增加的项数目标，增长后仍受 maxItemsPerRequest 限制"
        },
        "commentTranslatePlus.batchGrowthFactor": {
          "type": "number",
          "default": 1.25,
          "minimum": 1,
          "maximum": 4,
          "scope": "window",
          "description": "OpenAI 每次成功增长时字符软目标的乘数，向上取整并服从 maxRequestCharacters；1 表示字符目标不增长"
        },
        "commentTranslatePlus.batchShrinkFactor": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.1,
          "maximum": 1,
          "scope": "window",
          "description": "OpenAI 可恢复失败时项数与字符软目标的乘数，向下取整且至少 1 项/256 字符；恢复子批项数也受此系数限制，最后一次逐项尝试。1 表示不按比例缩小"
        },
        "commentTranslatePlus.maxTranslationAttempts": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "scope": "window",
          "description": "OpenAI 每个单元在一次翻译任务中的最大尝试次数，包含首次请求；1 表示不自动重试。仅结果协议、完整性或结构校验等可恢复失败会重试，成功项不再请求"
        },
        "commentTranslatePlus.preserveTermsRefreshSeconds": {
          "type": "integer",
          "default": 900,
          "minimum": 0,
          "maximum": 86400,
          "scope": "window",
          "description": "本地和网络保留词文件的定时刷新间隔（秒），0 表示仅手动刷新。不监听本地文件变化；命令“刷新保留词”可立即刷新。"
        }
      }
    },
    "submenus": [
      {
        "id": "commentTranslatePlus.browseMenu",
        "label": "注释翻译+"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "commentTranslatePlus.toggleDocumentBrowseMode",
          "when": "commentTranslatePlus.supported && !commentTranslatePlus.browse",
          "group": "navigation@20"
        },
        {
          "command": "commentTranslatePlus.toggleDocumentBrowseMode.active",
          "when": "commentTranslatePlus.supported && commentTranslatePlus.browse",
          "group": "navigation@20"
        },
        {
          "command": "commentTranslatePlus.preview",
          "when": "commentTranslatePlus.markdown",
          "group": "navigation@22"
        },
        {
          "command": "commentTranslatePlus.retranslatePreview",
          "when": "activeCustomEditorId == vscode.markdown.preview.editor && resourceScheme == comment-translate-plus-preview",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "submenu": "commentTranslatePlus.browseMenu",
          "when": "commentTranslatePlus.supported",
          "group": "navigation@20"
        }
      ],
      "commentTranslatePlus.browseMenu": [
        {
          "command": "commentTranslatePlus.translateAll",
          "group": "browse@1"
        },
        {
          "command": "commentTranslatePlus.toggleDocumentBrowseMode",
          "group": "browse@0"
        },
        {
          "command": "commentTranslatePlus.cancel",
          "group": "browse@2",
          "when": "commentTranslatePlus.browse"
        },
        {
          "command": "commentTranslatePlus.retranslate",
          "group": "browse@3",
          "when": "commentTranslatePlus.browse"
        },
        {
          "command": "commentTranslatePlus.retranslateBlock",
          "group": "browse@3.1"
        },
        {
          "command": "commentTranslatePlus.retry",
          "group": "browse@4",
          "when": "commentTranslatePlus.browse"
        },
        {
          "command": "commentTranslatePlus.showErrors",
          "group": "browse@5"
        },
        {
          "command": "commentTranslatePlus.setLanguages",
          "group": "browse@6"
        },
        {
          "command": "commentTranslatePlus.settings",
          "group": "browse@7"
        },
        {
          "command": "commentTranslatePlus.selectProfile",
          "group": "browse@8"
        },
        {
          "command": "commentTranslatePlus.toggleMode",
          "group": "browse@9"
        },
        {
          "command": "commentTranslatePlus.toggleHover",
          "group": "browse@10"
        },
        {
          "command": "commentTranslatePlus.toggleAuto",
          "group": "browse@11"
        },
        {
          "command": "commentTranslatePlus.preview",
          "group": "browse@12",
          "when": "commentTranslatePlus.markdown"
        },
        {
          "command": "commentTranslatePlus.translateAndReplace",
          "group": "browse@13"
        },
        {
          "command": "commentTranslatePlus.addCurrentFileToAutoExclude",
          "group": "browse@14"
        },
        {
          "command": "commentTranslatePlus.addCurrentFileToAutoInclude",
          "group": "browse@15"
        }
      ],
      "commandPalette": [
        {
          "command": "commentTranslatePlus.toggleDocumentBrowseMode.active",
          "when": "false"
        },
        {
          "command": "commentTranslatePlus.retranslatePreview",
          "when": "activeCustomEditorId == vscode.markdown.preview.editor && resourceScheme == comment-translate-plus-preview"
        }
      ]
    }
  }
}
