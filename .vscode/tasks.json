{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch",
      "type": "process",
      "command": "node",
      "args": ["tools/build.mjs", "--watch"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": { "regexp": "^(.*):(\\d+):(\\d+): (error|warning): (.*)$", "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5 },
        "background": { "activeOnStart": true, "beginsPattern": "^\\[watch\\] build started$", "endsPattern": "^\\[watch\\] build finished$" }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "web-host",
      "type": "process",
      "command": "node",
      "args": [
        "node_modules/@vscode/test-web/out/server/index.js",
        "--browser=chromium",
        "--waitForDebugger=9222",
        "--quality=stable",
        "--host=localhost",
        "--port=54238",
        "--extensionDevelopmentPath=.",
        "--testRunnerDataDir=.vscode-test/web",
        "fixtures/development"
      ],
      "dependsOn": "watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "web-host",
        "pattern": { "regexp": "^(.*):(\\d+):(\\d+): (error|warning): (.*)$", "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5 },
        "background": { "activeOnStart": true, "beginsPattern": "^(Downloading|Serving)", "endsPattern": "^Listening on http://localhost:54238" }
      },
      "presentation": { "reveal": "silent" }
    }
  ]
}
